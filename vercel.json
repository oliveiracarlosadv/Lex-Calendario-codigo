{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/monitoring",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/renew-webhooks",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/comunicacoes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/intimacoes",
      "schedule": "0 */2 * * *"
    }
  ]
}
