<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Lex Calendário</title>
    <welcome file="bemvindo.html" mime-type="text/html"/>
    <conclusion file="conclusao.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="__ARCH__"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="default"/>
    </choices-outline>
    <choice id="default" title="Lex Calendário">
        <pkg-ref id="br.adv.caao.lexcalendario.pkg"/>
    </choice>
    <pkg-ref id="br.adv.caao.lexcalendario.pkg" version="__VERSION__" onConclusion="none">lex-calendario-componente.pkg</pkg-ref>
</installer-gui-script>
