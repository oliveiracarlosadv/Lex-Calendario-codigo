# ───────────────────────────── App ─────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Lex Calendário"

# ─────────────────────────── Supabase ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (cron, webhooks, integrações). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de 32 bytes em base64 para criptografar tokens OAuth/CalDAV (AES-256-GCM)
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Segredo para proteger as rotas /api/cron/* (Vercel envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# ─────────────────────── FullCalendar Premium ──────────────────
# Licença comercial necessária para a visão "Equipe" (resource-timegrid)
NEXT_PUBLIC_FULLCALENDAR_LICENSE_KEY=

# ───────────────────────── Google Calendar ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────── Microsoft 365 / Outlook ───────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ──────────────────────────── Web Push ─────────────────────────
# Gere com: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# ──────────────────────────── E-mail ───────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Lex Calendário <agenda@seudominio.com.br>"

# ────────────────────── IA jurídica ────────────────────────────
# Padrão: Ollama com modelo open source e gratuito (https://ollama.com)
#   ollama pull qwen2.5:7b
# AI_PROVIDER: ollama | openai-compatible | anthropic | rules
# Se o modelo estiver indisponível, o motor usa apenas o analisador por regras.
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Para endpoints compatíveis com OpenAI servindo modelos abertos (vLLM, LM Studio, Groq, OpenRouter):
AI_BASE_URL=
AI_API_KEY=
# Opcional (comercial): AI_PROVIDER=anthropic e AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ───────────────────── Monitoramento processual ────────────────
# API Pública do DataJud (CNJ). Chave pública divulgada em datajud-wiki.cnj.jus.br
DATAJUD_API_KEY=
